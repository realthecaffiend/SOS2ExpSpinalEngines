					<li>
						<direction>Opposite</direction>
						<connectType>
							<li>engineAccelerator</li>
							<li>engineTankEnd</li>
						</connectType>
					</li>
				</acceptFrom>
			</li>
			<li Class="PipeSystem.CompProperties_RefillWithPipes" MayRequire ="hrg164hjo.vfefuelpipenet.sos2">
				<pipeNet>SoS2_UraniumPodNet</pipeNet>
				<thing>ShuttleFuelPods</thing>
			</li>
			<li Class="PipeSystem.CompProperties_Resource" MayRequire ="VanillaExpanded.VChemfuelE">
				<pipeNet>VCHE_ChemfuelNet</pipeNet>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTransmitter</compClass>
				<transmitsPower>true</transmitsPower>
			</li>
			<li Class="Rimefeller.CompProperties_Pipe" MayRequire="Dubwise.Rimefeller"/>
		</comps>
		<placeWorkers>
			<li>TheCafFiend.PlaceWorker_NeedsSpinalEngineMount</li>
			<li>SaveOurShip2.PlaceWorker_SpinalMountPort</li>
			<li>SaveOurShip2.PlaceWorker_OnShipHull</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>ShipEngineLarger</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<uiIconScale>0.65</uiIconScale>
	</ThingDef>
