<?xml version="1.0" encoding="utf-8"?>

<Defs>
	<DesignatorDropdownGroupDef>
		<defName>ShipEngines_Spinal</defName>
	</DesignatorDropdownGroupDef>
	<ThingDef ParentName="BuildingShipBase">
		<defName>Ship_Engine_Spinal_Chem</defName>
		<label>Spinal Chemfuel Exhaust</label>
		<designatorDropdown>ShipEngines_Spinal</designatorDropdown>
		<thingClass>Building</thingClass>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Ship/SpinalEngine_ExhaustBell</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(5,5)</drawSize>
		</graphicData>
		<statBases>
			<WorkToBuild>80000</WorkToBuild>
			<MaxHitPoints>1500</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<tickerType>Normal</tickerType>
		<description>A chemfuel-powered spinal engine. Not suitable for interplanetary travel. Designed to operate only in microgravity, so provides no capacity to liftoff from a planet without additional gravitational compensators.\n\nThrust: 2000+25% per amp\nFuel use: 4 chemfuel+25% per amp, per second</description>
		<researchPrerequisites>
			<li>ShipEngine</li>
			<li>ShipEngineLarge</li>
		</researchPrerequisites>
		<size>(5,4)</size>
		<receivesSignals>true</receivesSignals>
		<designationCategory>Ship</designationCategory>
		<comps>
			<li Class="SaveOurShip2.CompProps_ShipCachePart">
				<hermetic>true</hermetic>
			</li>
			<li Class="TheCafFiend.CompProperties_SpinalEngineMount">
				<emits>false</emits>
				<multiblockType>engineExhaust</multiblockType>
				<multiblockController>true</multiblockController>
				<acceptFrom>
					<li>
						<direction>None</direction> <!--Engines in SOS2 exhaust to the "back"! So connect to the other end-->
						<connectType>
							<li>engineAccelerator</li>
						</connectType>
					</li>
					<li>
						<direction>Clockwise</direction>
						<connectType>
							<li>EngineEmergencyOverdrive</li>
							<li>engineGravitationalCompensator</li>
						</connectType>
					</li>
					<li>
						<direction>Counterclockwise</direction>
						<connectType>
							<li>EngineEmergencyOverdrive</li>
							<li>engineGravitationalCompensator</li>
						</connectType>
					</li>
				</acceptFrom>
			</li>
			<li Class="CompProperties_Power">
				<compClass>TheCafFiend.CompSpinalEnginePowerTrader</compClass>
				<basePowerConsumption>100</basePowerConsumption>
				<transmitsPower>true</transmitsPower>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Refuelable">
				<fuelCapacity>2000.0</fuelCapacity>
				<targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
				<fuelFilter>
					<thingDefs>
						<li>Chemfuel</li>
					</thingDefs>
				</fuelFilter>
				<consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
				<autoRefuelPercent>0.9</autoRefuelPercent>
				<showFuelGizmo>false</showFuelGizmo>
				<drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
				<drawFuelGaugeInMap>false</drawFuelGaugeInMap>
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
			</li>
			<li Class="TheCafFiend.CompProperties_SpinalEngineTrail">
				<!--graphicData>
					<texPath>Things/Building/Ship/NuclearEngineTrail</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<drawSize>(7,36.5)</drawSize>
				</graphicData-->
				<thrust>4</thrust>
				<fuelUse>4</fuelUse>
				<takeOff>false</takeOff>
				<fuelAllowed>4</fuelAllowed>
				<soundWorking>ShipEngineFuel</soundWorking>
			</li>
			<li Class="Rimefeller.CompProperties_Pipe" MayRequire="Dubwise.Rimefeller"/>
		</comps>
		<placeWorkers>
			<li>TheCafFiend.PlaceWorker_NeedsSpinalEngineMount</li>
			<li>SaveOurShip2.PlaceWorker_ShipEngine</li>
		</placeWorkers>
		<building>
			<shipPart>true</shipPart>
		</building>
		<costList>
			<Steel>400</Steel>
			<Plasteel>80</Plasteel>
			<ComponentIndustrial>6</ComponentIndustrial>
			<ComponentSpacer>6</ComponentSpacer>
		</costList>
	</ThingDef>
	<ThingDef ParentName="BuildingShipBase">
		<defName>Ship_Engine_Spinal_Nuke</defName>
		<label>Spinal Nuclear Exhaust</label>
		<designatorDropdown>ShipEngines_Spinal</designatorDropdown>
		<thingClass>Building</thingClass>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Ship/SpinalEngine_ExhaustBell_Nuclear</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(5,5)</drawSize>
		</graphicData>
		<statBases>
			<WorkToBuild>80000</WorkToBuild>
			<MaxHitPoints>2500</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<tickerType>Normal</tickerType>
		<description>A nuclear-powered spinal engine. Not suitable for interplanetary travel. Designed to operate only in microgravity, so provides no capacity to liftoff from a planet without additional gravitational compensators.\n\nThrust: 2500+25% per amp\nFuel use: 3 fuel pods+25% per amp, per second</description>
		<researchPrerequisites>
			<li>ShipEngine</li>
			<li>ShipEngineLarger</li>
		</researchPrerequisites>
		<size>(5,4)</size>
		<receivesSignals>true</receivesSignals>
		<designationCategory>Ship</designationCategory>
		<comps>
			<li Class="SaveOurShip2.CompProps_ShipCachePart">
				<hermetic>true</hermetic>
			</li>
			<li Class="TheCafFiend.CompProperties_SpinalEngineMount">
				<emits>false</emits>
				<multiblockType>engineExhaust</multiblockType>
				<multiblockController>true</multiblockController>
				<acceptFrom>
					<li>
						<direction>None</direction>
						<!--Engines in SOS2 exhaust to the "back"! So connect to the other end-->
						<connectType>
							<li>engineAccelerator</li>
						</connectType>
					</li>
					<li>
						<direction>Clockwise</direction>
						<connectType>
							<li>EngineEmergencyOverdrive</li>
							<li>engineGravitationalCompensator</li>
						</connectType>
					</li>
					<li>
						<direction>Counterclockwise</direction>
						<connectType>
							<li>EngineEmergencyOverdrive</li>
							<li>engineGravitationalCompensator</li>
						</connectType>
					</li>
				</acceptFrom>
			</li>
			<li Class="CompProperties_Power">
				<compClass>TheCafFiend.CompSpinalEnginePowerTrader</compClass>
				<basePowerConsumption>200</basePowerConsumption>
				<transmitsPower>true</transmitsPower>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Refuelable">
				<fuelCapacity>4000.0</fuelCapacity>
				<targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
				<fuelFilter>
					<thingDefs>
						<li>ShuttleFuelPods</li>
					</thingDefs>
				</fuelFilter>
				<consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
				<autoRefuelPercent>0.9</autoRefuelPercent>
				<showFuelGizmo>false</showFuelGizmo>
				<drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
				<drawFuelGaugeInMap>false</drawFuelGaugeInMap>
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
			</li>
			<li Class="TheCafFiend.CompProperties_SpinalEngineTrail">
				<!--graphicData>
					<texPath>Things/Building/Ship/NuclearEngineTrail</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<drawSize>(7,36.5)</drawSize>
				</graphicData-->
				<thrust>5</thrust>
				<fuelUse>3</fuelUse>
				<takeOff>false</takeOff>
				<fuelAllowed>3</fuelAllowed>
				<soundWorking>ShipEngineFuel</soundWorking>
			</li>
		</comps>
		<placeWorkers>
			<li>TheCafFiend.PlaceWorker_NeedsSpinalEngineMount</li>
			<li>SaveOurShip2.PlaceWorker_ShipEngine</li>
		</placeWorkers>
		<building>
			<shipPart>true</shipPart>
		</building>
		<costList>
			<Steel>400</Steel>
			<Plasteel>80</Plasteel>
			<ComponentIndustrial>12</ComponentIndustrial>
			<ComponentSpacer>12</ComponentSpacer>
		</costList>
	</ThingDef>
	<ThingDef ParentName="BuildingBase">
		<defName>ShipGravitationalCompensator</defName>
		<label>Gravitational Launch compensator</label>
		<designatorDropdown>ShipEngines_Spinal</designatorDropdown>
		<description>Utilizes gravitational fields to create an artificial microgravity bubble around the engine structure, as well as providing greater control over exact exhaust direction. One on each side of the exhaust allows use in launch from gravity wells. Somewhat increases power use</description>
		<graphicData>
			<texPath>Things/Building/Ship/SpinalEngine_Solenoid_Archo</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(3,4)</drawSize>
		</graphicData>
		<size>(3,4)</size>
		<rotatable>true</rotatable>
		<tickerType>Normal</tickerType>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<castEdgeShadows>false</castEdgeShadows>
		<fillPercent>0.5</fillPercent>
		<designationCategory>Ship</designationCategory>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<WorkToBuild>1600</WorkToBuild>
			<Flammability>0.5</Flammability>
		</statBases>
		<costList>
			<Steel>100</Steel>
			<Uranium>10</Uranium>
			<Plasteel>80</Plasteel>
			<ComponentSpacer>8</ComponentSpacer>
		</costList>
		<comps>
			<li Class="TheCafFiend.CompProperties_SpinalEngineMount">
				<emits>true</emits>
				<powerUseAmp>2.00</powerUseAmp>
				<multiblockType>engineGravitationalCompensator</multiblockType>
				<acceptFrom>
					<li>
						<direction>Opposite</direction>
						<connectType>
							<li>invalidOnPurposeTypeThatDoesntExist</li>
						</connectType>
					</li>
				</acceptFrom>
			</li>
			<li Class="PipeSystem.CompProperties_RefillWithPipes" MayRequire ="hrg164hjo.vfefuelpipenet.sos2">
				<pipeNet>SoS2_UraniumPodNet</pipeNet>
				<thing>ShuttleFuelPods</thing>
			</li>
			<li Class="PipeSystem.CompProperties_Resource" MayRequire ="VanillaExpanded.VChemfuelE">
				<pipeNet>VCHE_ChemfuelNet</pipeNet>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTransmitter</compClass>
				<transmitsPower>true</transmitsPower>
			</li>
			<li Class="Rimefeller.CompProperties_Pipe" MayRequire="Dubwise.Rimefeller"/>
		</comps>
		<placeWorkers>
			<li>TheCafFiend.PlaceWorker_NeedsSpinalEngineMount</li>
			<li>SaveOurShip2.PlaceWorker_SpinalMountPort</li>
			<li>SaveOurShip2.PlaceWorker_OnShipHull</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>ShipEngineLarger</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<uiIconScale>0.65</uiIconScale>
	</ThingDef>
</Defs>
